# ============================================
# Highwatch RAG - Environment Configuration
# Copy to .env (never commit .env).
# ============================================

# --- LLM provider ---------------------------------------------------------
# groq (default, free plan) | gemini (AI Studio free tier) | extractive (no LLM)
# Paid-only providers such as OpenAI are rejected at startup ($0 budget).
LLM_PROVIDER=groq

# Groq: create a key at https://console.groq.com/keys (free plan).
# Do NOT add a payment method / upgrade if you want to guarantee $0.
GROQ_API_KEY=
# Check current IDs: curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

# Gemini (optional): key from https://aistudio.google.com in a project WITHOUT billing.
# Free tier: Google may use prompts/responses to improve products and humans may
# review them — don't send confidential documents.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024

# --- Google Drive (optional) ---------------------------------------------
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
# Comma-separated folder IDs (empty = every supported file you can see)
GOOGLE_DRIVE_FOLDER_IDS=
# true locally (opens a browser once); the Docker image sets false
GOOGLE_OAUTH_INTERACTIVE=true
DRIVE_MAX_FILE_MB=25
# Re-sync Drive at startup (useful on hosts that lose their disk, e.g. Render free)
AUTO_SYNC_ON_STARTUP=false
# For hosts without files: paste the JSON contents instead of paths
# GOOGLE_CREDENTIALS_JSON=
# GOOGLE_TOKEN_JSON=

# --- Embedding (local, free) ---------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=64
# EMBEDDING_CACHE_DIR=./.fastembed_cache

# --- Chunking (characters) -----------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MIN_CHUNK_SIZE=200

# --- Search ---------------------------------------------------------------
TOP_K_RESULTS=5
# Minimum cosine similarity for a chunk to count as relevant (tuned for bge-small)
SIMILARITY_THRESHOLD=0.55
# Unset = automatic BGE query instruction for BGE English models; set to empty to disable
# EMBEDDING_QUERY_PREFIX=

# --- Uploads --------------------------------------------------------------
MAX_UPLOAD_MB=10
ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.md

# --- Storage --------------------------------------------------------------
STORAGE_DIR=./storage
FAISS_INDEX_PATH=./storage/faiss_index
DOCUMENTS_DB_PATH=./storage/documents.json
# local ($0) | gcs (needs a billing-enabled GCP project — read README first)
STORAGE_BACKEND=local
# GCS_BUCKET=
# GCS_PREFIX=highwatch-rag

# --- Security -------------------------------------------------------------
# Set before exposing the app on the internet: all endpoints except
# /health and /config then require the X-API-Key header.
API_KEY=
# Only needed if another website calls this API (comma-separated origins)
CORS_ORIGINS=

# --- Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
# console (local) | json (Cloud Logging-compatible)
LOG_FORMAT=console
